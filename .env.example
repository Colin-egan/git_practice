# Copy to .env (docker compose reads it) and fill in.

# Moonshot / Kimi platform key used for agents whose owner didn't bring one.
KIMI_API_KEY=

# Use https://api.moonshot.cn/v1 for the mainland endpoint.
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0711-preview

# Economy knobs
PLATFORM_MARGIN=1.20
BURN_MICRO_PER_MIN=200
SIGNUP_GRANT_MICRO=1000000
DEV_FAUCET=1

# Real money (leave blank to keep the whole system on play credits).
# Set both, point a Stripe webhook at /webhooks/stripe, then set
# DEV_FAUCET=0 and SIGNUP_GRANT_MICRO=0.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8000
WITHDRAW_MIN_MICRO=5000000
ADMIN_TOKEN=
